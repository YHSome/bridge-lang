# 三数之和：排序 + 双指针，O(n^2)
# 用法一：python 桥.py 运行 示例/三数之和.bridge < 输入.txt
# 用法二：直接跑（不给输入时用题目样例，方便看效果）

导入 运行环境


定义 求解(数组):
    """返回所有和为 0 的不重复三元组（三元组内部升序、整体字典序）"""
    数组.排序()
    n = 求长度(数组)
    结果 = []
    对于 i 在 范围(n - 2):
        如果 i 大于 0 且 数组[i] == 数组[i - 1]:
            继续                                   # 第一个数去重
        j = i + 1
        k = n - 1
        当 j 小于 k:
            三数和 = 数组[i] + 数组[j] + 数组[k]
            如果 三数和 == 0:
                结果.追加((数组[i], 数组[j], 数组[k]))
                当 j 小于 k 且 数组[j] == 数组[j + 1]:
                    j += 1                         # 第二个数去重
                当 j 小于 k 且 数组[k] == 数组[k - 1]:
                    k -= 1                         # 第三个数去重
                j += 1
                k -= 1
            否则如果 三数和 小于 0:
                j += 1                             # 太小了，左指针右移
            否则:
                k -= 1                             # 太大了，右指针左移
    返回 结果


定义 主():
    数据 = 运行环境.标准输入.缓冲.读().split()
    如果 不是 数据:
        数据 = b"6 -1 0 1 2 -1 -4".split()          # 没给输入就看样例
    n = 整数(数据[0])
    数组 = 排序(整数(v) 对于 v 在 数据[1:1 + n])

    结果 = 求解(数组)

    行们 = [f"{求长度(结果)}"]
    对于 三元组 在 结果:
        行们.追加(f"{三元组[0]} {三元组[1]} {三元组[2]}")
    运行环境.标准输出.写("\n".连接(行们) + "\n")


如果 __name__ == "__main__":
    主()
