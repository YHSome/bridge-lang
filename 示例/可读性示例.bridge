# 可读性示例：整份代码里没有 with、没有 lambda、没有 __name__、没有冒号切片
#
# 运行：python 桥.py 运行 示例/可读性示例.bridge
# 看翻译：python 桥.py 查看 示例/可读性示例.bridge

类 学生:
    定义 初始化(自己, 名字, 分数):
        自己.名字 = 名字
        自己.分数 = 分数

    定义 报告(自己):
        返回 f"{自己.名字} 考了 {自己.分数} 分"

    定义 显示(自己):
        返回 自己.报告()

    定义 表示(自己):
        返回 自己.报告()


如果 是主程序:
    全班 = [学生("小明", 90), 学生("小红", 78), 学生("小刚", 95)]

    # 排序：不用写 lambda，也不用记 key= / reverse=
    排名 = 排队(全班, 按="分数", 大的在前=真)

    输出（"=== 排名 ==="）
    对于 序号, 人 在 逐个编号(排名):
        输出（序号 + 1, "，", 人.报告()）

    # 切片：不用冒号，从 1 数起，两头都算
    输出（"=== 取片段 ==="）
    输出（"第 1 到 2 名：", 第几个到第几个(排名, 1, 2)）
    输出（"第一名：", 最后一个(倒过来(排名)).报告())

    数字 = [3, 1, 4, 1, 5]
    输出（"前三个人数：", 前几个(数字, 3), " 倒过来：", 倒过来(数字)）

    # 异常：不用 as，直接"记作"
    输出（"=== 异常 ==="）
    尝试执行:
        整数("这不是数字")
    捕获 值错误 记作 出错:
        输出（"抓到了：", 出错）
