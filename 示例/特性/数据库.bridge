导入 路径

库 = 读取("./示例数据库.db")
书表 = 库.建表("图书", {
    "书名": "TEXT NOT NULL",
    "作者": "TEXT",
    "册数": "INTEGER DEFAULT 1",
})

书表.插入({"书名": "三体", "作者": "刘慈欣", "册数": 3})
书表.插入({"书名": "活着", "作者": "余华", "册数": 2})
书表.插入({"书名": "球状闪电", "作者": "刘慈欣", "册数": 1})

输出（"行数：", 书表.行数)
输出（"全部：", 书表.全部())
输出（"刘慈欣的书：", 书表.查询("作者 = ?", ["刘慈欣"]))

书表.更新({"册数": 5}, "书名 = ?", ["三体"])
输出（"三体册数：", 书表.查询("书名 = ?", ["三体"])[0]["册数"])

书表.删除行("册数 < ?", [2])
输出（"删后行数：", 书表.行数)

书表.建索引(["作者"])
输出（"表：", 库.表们())

库.关闭()
库.删除自己()
