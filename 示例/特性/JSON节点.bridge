# 读取和操作 JSON：`读取("x.json")` 得到能按字段操作的对象
# 运行：python 桥.py 运行 示例/特性/JSON节点.bridge

配置 = 读取("./配置.json")

输出（"站点名：", 配置.站点名）          # 属性写法
输出（"端口：", 配置["端口"]）           # 下标写法，两种都行
输出（"数据库主机：", 配置.数据库.主机）   # 嵌套对象一层层点
输出（"第一个管理员：", 配置.管理员[0]）   # 数组照常用下标
输出（"条目数：", 配置.条目数）

配置.端口 = 9090
配置.数据库.主机 = "localhost"
配置.管理员.追加（"王五")                 # 数组追加
配置.保存()

输出（"点号路径取：", 配置.取("数据库.主机")）
输出（"有没有端口：", 配置.有("端口"))
输出（"有没有域名：", 配置.有("域名"))
输出（"现在整份是：")
输出（配置）

# 复原，方便反复运行
配置.端口 = 8080
配置.数据库.主机 = "127.0.0.1"
配置.管理员 = ["张三", "李四"]
配置.保存()
