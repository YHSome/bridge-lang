# 读取文档：`文档` 是 `文件` 的子类
# 运行：python 桥.py 运行 示例/特性/读取文档.bridge

文档 = 读取("./a.txt")

输出（"文件名：", 文档.文件名, " 后缀：", 文档.后缀）
输出（"第一个字符：", 文档[0]）
输出（"内容：", 文档）
输出（"大小（字节）：", 文档.大小）
输出（"它是不是文件：", 是实例(文档, 文件)）

# 改名（方法形式；写 `文档.文件名 = "b.txt"` 效果一样）
文档.改名("b.txt")
输出（"改名后：", 文档.文件名）

# 改内容 = 回写文件；追加是便捷写法
文档.内容 = 文档.内容 + "你好"
输出（"加完：", 文档.内容）
文档.追加("（追加）")
输出（"追加后：", 文档.内容）

复制 = 文档.复制到("./b副本.txt")
输出（"复制出来：", 复制.文件名, " ", 复制.内容）

# 收尾：名字和内容都复原，方便反复运行
文档.内容 = "你好，世界！\n"
文档.改名("a.txt")
复制.删除自己()
