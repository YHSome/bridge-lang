# 网络对象：取网页 / 发请求
# 这里用 file:// 读本地文件演示（不用联网也能跑）；真用时换成 https 地址即可。

导入 路径

本目录 = 路径.取目录(路径.绝对路径(__file__))
文件 = 路径.拼接(本目录, "配置.json").替换("\\", "/")
响应 = 取网页("file:///" + 文件)

输出（"状态码：", 响应.状态码, " 正常：", 响应.正常)
输出（"内容长度：", 求长度(响应.内容))
输出（"文本前 20：", 响应.文本[:20])

配置 = 响应.JSON
输出（"站点名：", 配置.站点名, " 端口：", 配置.端口)

# 真发 HTTP 时：
# 结果 = 取网页("https://example.com")
# 另存 = 结果.保存("./页面.html")
# 提交 = 发请求("https://example.com/api", {"名字": "爸爸"}, 方法="POST")
