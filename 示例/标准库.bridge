# 标准库演示：时间 / 路径 / 系统 / json
# 运行：python 桥.py 运行 示例/标准库.bridge

导入 时间
导入 路径
导入 系统
导入 json
导入 运行环境

# ---- 时间 ----
时间.睡眠(0)
现在 = 时间.当前时间戳()
输出（"时间戳是正数：", 现在 大于 0）
输出（"类型对得上：", 类型(现在) 等于 浮点）

# ---- 路径 ----
路径文本 = 路径.拼接("数据", "oj.db")
输出（"扩展名：", 路径.拆扩展名(路径文本)【1】)
输出（"文件名：", 路径.取文件名(路径文本)）
输出（"是绝对路径：", 路径.是绝对(路径文本)）

# ---- 系统 ----
输出（"系统名合法：", 系统.系统名 在 ("nt", "posix")）

# ---- 运行环境（sys）----
输出（"平台：", 运行环境.平台）
输出（"字节序：", 运行环境.字节序）
输出（"递归上限：", 运行环境.递归上限()）

# ---- json ----
数据 = {"科目": "数学", "分数": 95, "标签": 【"a", "b"】}
文本 = json.转字符串(数据, ensure_ascii=假)
输出（"JSON：", 文本)
回来 = json.解析(文本)
输出（"解回来：", 回来【"科目"】, 回来【"分数"】, 回来【"标签"】)

# 英文原名照样能用（.bridge 是 Python 的超集）
print(json.dumps({"raw": True}, ensure_ascii=False))
