{
  "comments": { "lineComment": "#", "blockComment": ["\"\"\"", "\"\"\""] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "[:：]\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(否则|否则如果|捕获|最后|except|else|elif|finally)\\b"
  }
}
