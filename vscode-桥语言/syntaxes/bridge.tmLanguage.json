{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "桥语言",
  "scopeName": "source.bridge",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#定义名"
    },
    {
      "include": "#模块成员"
    },
    {
      "include": "#方法调用"
    },
    {
      "include": "#句式糖"
    },
    {
      "include": "#异常"
    },
    {
      "include": "#内建"
    },
    {
      "include": "#运算符词"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#全角标点"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.number-sign.bridge",
          "match": "#.*$"
        },
        {
          "name": "comment.block.documentation.bridge",
          "begin": "[rRuUbBfF]*\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "comment.block.documentation.bridge",
          "begin": "[rRuUbBfF]*'''",
          "end": "'''"
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.triple.bridge",
          "begin": "[rRuUbBfF]*\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.bridge",
          "begin": "[rRuUbBfF]*'''",
          "end": "'''",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.bridge",
          "begin": "[rRuUbBfF]*\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.bridge",
          "begin": "[rRuUbBfF]*'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.bridge",
          "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d*)?(?:[eE][+-]?\\d+)?j?)\\b"
        }
      ]
    },
    "定义名": {
      "patterns": [
        {
          "match": "(定义|类|def|class)\\s+([^\\s(（:：]+)",
          "captures": {
            "1": {
              "name": "storage.type.function.bridge"
            },
            "2": {
              "name": "entity.name.function.bridge"
            }
          }
        }
      ]
    },
