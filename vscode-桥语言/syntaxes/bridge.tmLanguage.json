{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "桥语言",
  "scopeName": "source.bridge",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#定义名"
    },
    {
      "include": "#模块成员"
    },
    {
      "include": "#方法调用"
    },
    {
      "include": "#句式糖"
    },
    {
      "include": "#异常"
    },
    {
      "include": "#内建"
    },
    {
      "include": "#运算符词"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#全角标点"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.number-sign.bridge",
          "match": "#.*$"
        },
        {
          "name": "comment.block.documentation.bridge",
          "begin": "[rRuUbBfF]*\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "comment.block.documentation.bridge",
          "begin": "[rRuUbBfF]*'''",
          "end": "'''"
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.triple.bridge",
          "begin": "[rRuUbBfF]*\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.bridge",
          "begin": "[rRuUbBfF]*'''",
          "end": "'''",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.bridge",
          "begin": "[rRuUbBfF]*\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.bridge",
          "begin": "[rRuUbBfF]*'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bridge",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.bridge",
          "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d*)?(?:[eE][+-]?\\d+)?j?)\\b"
        }
      ]
    },
    "定义名": {
      "patterns": [
        {
          "match": "(定义|类|def|class)\\s+([^\\s(（:：]+)",
          "captures": {
            "1": {
              "name": "storage.type.function.bridge"
            },
            "2": {
              "name": "entity.name.function.bridge"
            }
          }
        }
      ]
    },
    "模块成员": {
      "patterns": [
        {
          "match": "(json)\\s*\\.\\s*((?:转字符串|写文件|读文件|解析))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(临时文件)\\s*\\.\\s*((?:创建临时文件|创建临时目录|临时目录名|临时名字|临时文件|临时目录|默认目录))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(压缩)\\s*\\.\\s*((?:坏压缩包|是压缩包|压缩包|尽量压|解压到|信息|只读|解压))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(命令行)\\s*\\.\\s*((?:参数错误|解析器))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(哈希)\\s*\\.\\s*((?:常用摘要|文件摘要|新建摘要|一二八|二五六|五一二))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(子进程)\\s*\\.\\s*((?:完成进程|标准输出|检查调用|获取输出|超时错误|空设备|管道|调用|运行))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(数学)\\s*\\.\\s*((?:以二为底对数|两参反正切|反双曲余弦|反双曲正切|反双曲正弦|弧度转角度|整数平方根|最大公约数|最小公倍数|角度转弧度|全圆周率|判断无穷|判断有限|判断非数|勾股斜边|双曲余弦|双曲正切|双曲正弦|向上取整|向下取整|复制符号|对数加一|常用对数|拆分小数|拆分浮点|拼回浮点|指数减一|整数部分|浮点余数|精确求和|自然常数|近似相等|反余弦|反正切|反正弦|圆周率|平方根|排列数|欧拉数|立方根|组合数|绝对值|余弦|取余|对数|开方|指数|无穷|正切|正弦|距离|连乘|阶乘|非数|幂))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(数据库)\\s*\\.\\s*((?:完整性错误|操作错误|数据错误|连接|行))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(日志)\\s*\\.\\s*((?:信息级别|取记录器|基础配置|异常日志|警告级别|记录严重|记录信息|记录警告|记录调试|记录错误|调试级别|错误级别))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(日期)\\s*\\.\\s*((?:世界时现在|从时间戳|今天|合并|现在|解析))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(时间)\\s*\\.\\s*((?:处理器时间|当前时间戳|格式化时间|升序时间|单调时钟|本地时间|解析时间|转字符串|转时间戳|世界时|延时|睡眠|计数))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(正则)\\s*\\.\\s*((?:ASCII模式|忽略大小写|全部查找|替换计数|点号通配|详细模式|逐个查找|全匹配|匹配|多行|拆分|替换|查找|编译|转义))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(线程)\\s*\\.\\s*((?:守护线程|当前线程|条件变量|定时器|活跃数|递归锁|事件|线程|锁))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(统计)\\s*\\.\\s*((?:总体标准差|低中位数|几何平均|总体方差|调和平均|高中位数|中位数|分位数|标准差|众数|平均|方差))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(编码)\\s*\\.\\s*((?:编码十六进制|网址安全编码|网址安全解码|解码十六进制|编码三二|编码八五|解码三二|解码八五|编码|解码))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(网络)\\s*\\.\\s*((?:获取|请求))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(路径)\\s*\\.\\s*((?:修改时间|共通前缀|取文件名|拆扩展名|真实路径|绝对路径|取目录|是文件|是目录|是绝对|是链接|规范化|大小|存在|拆分|拼接))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(系统)\\s*\\.\\s*((?:建临时文件|覆盖重命名|切换目录|列出目录|创建目录|删除目录|取进程号|当前目录|执行命令|扫描目录|分隔符|取环境|建目录|换行符|系统名|重命名|删除|环境))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(运行环境)\\s*\\.\\s*((?:文件系统编码|设置递归上限|可执行文件|导入路径|开关间隔|最大整数|标准输入|标准输出|标准错误|设置开关|递归上限|默认编码|字节序|实现名|已加载|模块表|版本号|参数|平台|版本|退出))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(迭代工具)\\s*\\.\\s*((?:组合含重复|无限循环|无限计数|无限重复|笛卡尔积|压缩长|分组|切片|压平|成对|排列|累计|组合|链))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(队列)\\s*\\.\\s*((?:后进先出队列|优先队列|简单队列|队列|队满|队空))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(随机)\\s*\\.\\s*((?:均匀随机|打乱顺序|随机整数|随机浮点|多选|样本|洗牌|种子|选择|高斯))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        },
        {
          "match": "(集合工具)\\s*\\.\\s*((?:双端队列|命名元组|有序字典|默认字典|计数器|链映射))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "support.class.module.bridge"
            },
            "2": {
              "name": "entity.name.function.member.bridge"
            }
          }
        }
      ]
    },
    "方法调用": {
      "patterns": [
        {
          "match": "(\\.)\\s*((?:十六进制摘要|是否数字字母|等待完成队列|格式化日期|添加子命令|首字母大写|任务完成|入队不等|全部查找|减去计数|出现最多|出队不等|十六进制|去除空白|合并更新|已知参数|开始位置|当前位置|批量添加|日期部分|是否字母|是否数字|是否空白|标准输出|标准错误|添加参数|添加开关|结束位置|解析参数|设置默认|值列表|元素们|初始化|加进去|去前缀|去后缀|去空格|右对齐|左对齐|左弹出|开头是|摘要值|星期几|标题化|格式化|结尾是|解压到|转大写|转小写|返回码|追加左|键列表|倒序|入队|关闭|内容|写入|出队|分割|分组|列出|刷新|匹配|去掉|反转|取值|取出|复制|大写|天数|定位|小写|居中|弹出|打包|扩展|找到|拆分|拷贝|排序|插入|更新|替换|条目|查找|添加|清空|移除|索引|组们|缓冲|编码|获取|补零|解压|解码|计数|读取|跨度|连接|追加|值|写|组|读|键))(?![A-Za-z0-9_一-鿿])",
          "captures": {
            "1": {
              "name": "punctuation.separator.method.bridge"
            },
            "2": {
              "name": "entity.name.function.method.bridge"
            }
          }
        }
      ]
    },
    "句式糖": {
      "patterns": [
        {
          "name": "keyword.operator.sugar.bridge",
          "match": "(?<![A-Za-z0-9_一-鿿])(?:继续下一次循环|进入下一次循环|当前是主程序|结束本次循环|重复执行直到|中的每一项|捕获异常时|一直循环|一直重复|定义函数|尝试执行|无论如何|是主程序|永久循环|跳出循环|重复执行|不换行|就重复|整除商|死循环|设定为|赋值成|中的|为止|交换|减少|加到|增加|每个|的话|直到|表示|记作|设为|那么|重复)(?![A-Za-z0-9_一-鿿])"
        }
      ]
    },
    "异常": {
      "patterns": [
        {
          "name": "support.class.exception.bridge",
          "match": "(?<![A-Za-z0-9_一-鿿])(?:文件未找到错误|HTTP错误|JSON错误|完整性错误|数据库错误|文件没找到|停止迭代|内存错误|名字错误|名称错误|基础异常|导入错误|属性缺失|属性错误|操作错误|断言错误|权限错误|溢出错误|类型不符|类型错误|索引错误|编码失败|网络错误|解码错误|超时错误|递归错误|除零错误|值错误|键错误|异常|除零)(?![A-Za-z0-9_一-鿿])"
        }
      ]
    },
    "内建": {
      "patterns": [
        {
          "name": "support.function.builtin.bridge",
          "match": "(?<![A-Za-z0-9_一-鿿])(?:第几个到第几个|打开压缩包|打开数据库|任一为真|删除文件|四舍五入|打开目录|排序结果|新建文档|最后一个|求最大值|求最小值|求绝对值|等待完成|读二进制|读取输入|转字符串|逐个编号|下一个|倒过来|全为真|前几个|发请求|取最大|取最小|取网页|取长度|合计值|商和余|字符串|建目录|时间差|是实例|求总和|求排序|求长度|绝对值|转布尔|转整数|转浮点|任意|假值|元组|全部|列表|区间|复述|字典|布尔|帮助|并行|打包|打印|打开|拉链|排序|排队|整数|映射|显示|最大|最小|枚举|求和|没有|浮点|真值|空值|类型|自己|自身|范围|读取|输入|输出|过滤|运行|迭代|长度|集合)(?![A-Za-z0-9_一-鿿])"
        }
      ]
    },
    "运算符词": {
      "patterns": [
        {
          "name": "keyword.operator.word.bridge",
          "match": "(?<![A-Za-z0-9_一-鿿])(?:大于或等于|小于或等于|大于等于|小于等于|按位取反|按位异或|不大于|不小于|不成立|不相等|不等于|按位与|按位或|赋值为|不是|乘以|乘方|减去|加上|取模|右移|大于|小于|左移|并且|或者|整除|相等|等于|而且|至多|至少|除以|与|且|在|或|是|非)(?![A-Za-z0-9_一-鿿])"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.bridge",
          "match": "(?<![A-Za-z0-9_一-鿿])(?:不然如果|停止循环|匿名函数|否则如果|下一步|否则若|子程序|捕获到|非局部|不然|中断|交出|产出|作为|倘若|假值|假如|假若|全局|其余|函数|删掉|删除|占位|只要|否则|回传|如果|定义|对于|导入|尝试|异步|引入|引发|当作|情形|抛出|捕获|断言|最后|最终|来自|真值|确保|空值|等待|类别|继续|虚无|试着|跳出|跳过|载入|返回|连同|通过|遍历|配对|从|假|对|带|当|真|空|类|若|错)(?![A-Za-z0-9_一-鿿])"
        }
      ]
    },
    "全角标点": {
      "patterns": [
        {
          "name": "punctuation.bridge",
          "match": "[，。：；（）【】「」『』]"
        }
      ]
    }
  }
}
