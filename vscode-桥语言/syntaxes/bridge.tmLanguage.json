{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "桥语言",
  "scopeName": "source.bridge",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#定义名"
    },
    {
      "include": "#模块成员"
    },
    {
      "include": "#方法调用"
    },
    {
      "include": "#句式糖"
    },
    {
      "include": "#异常"
    },
    {
      "include": "#内建"
    },
    {
      "include": "#运算符词"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#全角标点"
    }
