# 06 字符串：引号 / 拼接 / 长度 / 包含 / 替换 / 拆分 / 类型转换
# 对照文件：金标准/06_字符串.py，第 1 行起逐行对应

问候 = "你好，世界！"
名字 = "爸爸"

输出(问候)
输出(名字 + "，欢迎")
输出("长度：", 求长度(问候))
输出("包含：", "世界" 在 问候)
输出("替换：", 问候.替换("世界", "桥语言"))
输出("大写：", "abc".大写())
输出("去空白：", "  两侧空格  ".去除空白())

句子 = "以逗号,分隔,的文本"
输出("拆分：", 句子.拆分(","))
输出("数字：", 整数("42") + 1, 浮点("1.5") * 2)
输出("格式化：", "我叫%s，今年%d岁" % (名字, 18))
