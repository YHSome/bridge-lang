# 05 容器：列表 / 字典 / 元组 / 集合 / 切片 / 长度 / 求和
# 对照文件：手打同名 .bridge，第 1 行起逐行对应

数据 = [3, 1, 4, 1, 5, 9]
输出("原列表：", 数据)
输出("长度：", 求长度(数据))
输出("排序：", 求排序(数据))
输出("前三个：", 数据[0:3])
输出("倒数两个：", 数据[-2:])
输出("求和：", 求和(数据), "最大：", 求最大值(数据), "最小：", 求最小值(数据))

成绩表 = {"语文": 90, "数学": 85}
成绩表["英语"] = 78
输出("字典：", 成绩表)
输出("语文：", 成绩表["语文"])

坐标 = (3, 4)
输出("元组：", 坐标, "第一个：", 坐标[0])

去重 = 集合(数据)
输出("集合长度：", 求长度(去重))

数据.追加(7)
输出("追加后：", 数据)
