# 02 分支：如果 / 否则如果 / 否则 / 比较 / 逻辑运算
# 对照文件：手打同名 .bridge，第 1 行起逐行对应

分数 = 86
等级 = ""

如果 分数 >= 90:
    等级 = "优秀"
否则如果 分数 >= 60:
    等级 = "及格"
否则:
    等级 = "不及格"
输出("分数：", 分数, "等级：", 等级)

成年 = 分数 > 18
如果 成年 并且 非 分数 < 0:
    输出("逻辑：并且 + 不是 命中")
如果 成年 或 分数 > 100:
    输出("逻辑：或者 命中")

如果 分数 == 86:
    输出("比较：等于 命中")
如果 分数 != 100:
    输出("比较：不等于 命中")
如果 等级 是 非 空值:
    输出("比较：是 不是 空 命中")
