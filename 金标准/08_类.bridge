# 08 类：类 / 初始化 / 属性 / 方法 / 继承
# 对照文件：金标准/08_类.py，第 1 行起逐行对应

类 动物:
    定义 __init__(self, 名字, 年龄):
        self.名字 = 名字
        self.年龄 = 年龄

    定义 叫声(self):
        返回 "……"

    定义 介绍(self):
        返回 self.名字 + "，" + 转字符串(self.年龄) + "岁"

类 狗(动物):
    定义 叫声(self):
        返回 "汪汪"

类 猫(动物):
    定义 叫声(self):
        返回 "喵"

小黑 = 狗("小黑", 3)
小白 = 猫("小白", 2)
输出("名字：", 小黑.名字)
输出("介绍：", 小黑.介绍())
输出("狗叫：", 小黑.叫声())
输出("猫叫：", 小白.叫声())
输出("是否实例：", 是实例(小黑, 动物))
输出("类型名：", 类型(小黑).__name__)
