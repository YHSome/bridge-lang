# 04 函数：定义 / 参数 / 默认值 / 返回 / 多返回值
# 对照文件：手打同名 .bridge，第 1 行起逐行对应

定义 加法(a, b):
    返回 a + b

定义 问候(名字, 前缀="你好"):
    返回 前缀 + "，" + 名字

定义 极值(数据):
    返回 求最大值(数据), 求最小值(数据)

定义 累加(数据, 起始=0):
    合计 = 起始
    对于 值 在 数据:
        合计 = 合计 + 值
    返回 合计

定义 无返回():
    输出("这句话来自 无返回")

输出("加法：", 加法(2, 3))
输出("问候：", 问候("爸爸"))
输出("问候：", 问候(前缀="早上好", 名字="桥语言"))
大, 小 = 极值([3, 1, 4, 1, 5])
输出("最大：", 大, "最小：", 小)
输出("累加：", 累加([1, 2, 3]), 累加([1, 2, 3], 10))
无返回()
