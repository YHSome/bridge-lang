# 09 模块：导入 / 从 / 作为 / 模块成员翻译
# 对照文件：金标准/09_模块.py，第 1 行起逐行对应

导入 数学
导入 随机

输出("圆周率：", 数学.圆周率)
输出("开方：", 数学.开方(16))
输出("2的10次方：", 数学.幂(2, 10))
输出("最大公约数：", 数学.最大公约数(12, 18))
输出("向上取整：", 数学.向上取整(3.2))

随机.种子(42)
输出("随机整数：", 随机.随机整数(1, 6))
输出("选择：", 随机.选择(["甲", "乙", "丙"]))

从 数学 导入 floor
输出("向下取整：", floor(3.9))

从 数学 导入 sqrt 作为 开方
输出("开方(别名)：", 开方(81))
