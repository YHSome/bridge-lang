# 03 循环：对于 / 在 / 范围 / 当 / 中断 / 继续
# 对照文件：手打同名 .bridge，第 1 行起逐行对应

合计 = 0
对于 i 在 范围(1, 6):
    合计 = 合计 + i
输出("1到5之和：", 合计)

对于 名称 在 ["甲", "乙", "丙"]:
    输出("名字：", 名称)

计数 = 0
当(计数 < 5):
    计数 = 计数 + 1
    如果 计数 == 3:
        下一步
    输出("计数：", 计数)

对于 i 在 范围(10):
    如果 i == 4:
        跳出
    输出("直到四：", i)

对于 序号, 名称 在 枚举(["甲", "乙"]):
    输出("枚举：", 序号, 名称)
