# 10 综合：小成绩统计（综合运用前 9 份的内容）
# 对照文件：手打同名 .bridge，第 1 行起逐行对应

成绩 = {"语文": 90, "数学": 85, "英语": 78}

定义 总分(成绩表):
    合计 = 0
    对于 科目 在 成绩表:
        合计 = 合计 + 成绩表[科目]
    返回 合计

定义 评级(分数):
    如果 分数 >= 90:
        返回 "优秀"
    否则如果 分数 >= 70:
        返回 "良好"
    否则:
        返回 "待提升"

总计 = 总分(成绩)
平均分 = 总计 / 求长度(成绩)

输出("成绩单：", 成绩)
输出("总分：", 总计)
输出("平均分：", 平均分)
输出("评级：", 评级(平均分))

对于 科目, 分数 在 成绩.内容():
    输出(科目, "：", 分数, "→", 评级(分数))
