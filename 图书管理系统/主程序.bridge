"""图书管理系统 · 主程序（命令行菜单）

运行：
    python 桥.py 运行 图书管理系统/主程序.bridge

设计：菜单用 `标记/跳转到` 做循环（桥语言独有），业务全在 图书.bridge，
存储全在 数据.bridge——主程序只管"问用户、调函数、打印结果"。
"""

导入 运行环境
导入 数据
导入 图书

数据文件 = 空
库 = 数据.读库(数据文件)


定义 打印书行(书):
    """一行一本书：编号 书名 / 作者 库存"""
    可借 = 图书.可借数(书)
    输出（f"  #{书['编号']:<3} 《{书['书名']}》  作者：{书['作者']}  "
          f"在借 {书['在借']}/{书['总数']}  可借 {可借}")


定义 打印清单(清单):
    如果 不是 清单:
        输出（"  （没有匹配的书）")
        返回
    对于 书 在 清单:
        打印书行(书)


定义 显示菜单():
    输出（"")
    输出（"================ 图书管理系统 ================")
    输出（"  1 添加图书    2 图书清单    3 搜索")
    输出（"  4 借书        5 还书        6 删除图书")
    输出（"  7 统计        8 借阅清单    9 备份")
    输出（"  0 退出")
    输出（"============================================")


定义 要整数(提示):
    """把用户输入转成整数；不是数字就返回 空"""
    原文 = 输入(提示).去除空白()
    尝试执行:
        返回 整数(原文)
    捕获 值错误:
        返回 空


定义 新增流程():
    书名 = 输入("书名：")
    作者 = 输入("作者：")
    册数 = 要整数("册数（回车默认 1）：")
    如果 册数 是 空:
        册数 = 1
    记录, 是新的 = 图书.新增(库, 书名, 作者, 册数)
    数据.保存(库, 数据文件)
    如果 是新的:
        输出（f"已添加 #{记录['编号']} 《{记录['书名']}》 共 {记录['总数']} 册")
    否则:
        输出（f"《{记录['书名']}》已存在，现在共 {记录['总数']} 册")


定义 搜索流程():
    词 = 输入("搜书名/作者/编号：")
    打印清单(图书.搜索(库, 词))


定义 借书流程():
    编号 = 要整数("图书编号：")
    如果 编号 是 空:
        输出（"编号得是数字")
        返回
    借阅人 = 输入("借阅人：")
    尝试执行:
        记录 = 图书.借书(库, 编号, 借阅人)
        数据.保存(库, 数据文件)
        输出（f"已借出：《{记录['书名']}》 给 {记录['借阅人']}，应还 {记录['应还']}（借出 {记录['借出']}）")
    捕获 值错误 作为 错误:
        输出（"借不了：", 错误)


定义 还书流程():
    编号 = 要整数("图书编号：")
    如果 编号 是 空:
        输出（"编号得是数字")
        返回
    借阅人 = 输入("借阅人（回车表示谁都行）：")
    尝试执行:
        记录 = 图书.还书(库, 编号, 借阅人)
        数据.保存(库, 数据文件)
        输出（f"已归还：《{记录['书名']}》 借阅人 {记录['借阅人']}")
        如果 记录["逾期天数"] 大于 0:
            输出（f"  逾期 {记录['逾期天数']} 天，罚金 {记录['罚金']} 元")
        否则:
            输出（"  没有逾期，不收罚金")
    捕获 值错误 作为 错误:
        输出（"还不了：", 错误)


定义 下架流程():
    编号 = 要整数("要删的图书编号：")
    如果 编号 是 空:
        输出（"编号得是数字")
        返回
    尝试执行:
        书 = 图书.下架(库, 编号)
        数据.保存(库, 数据文件)
        输出（f"已删除 #{编号} 《{书['书名']}》")
    捕获 值错误 作为 错误:
        输出（"删不了：", 错误)


定义 汇总流程():
    数 = 图书.汇总(库)
    输出（"  书目数：", 数["书目数"], "  总册数：", 数["总册数"])
    输出（"  在借册数：", 数["在借册数"], "  可借册数：", 数["可借册数"])
    输出（"  借阅记录：", 数["借阅记录数"])


定义 借阅清单流程():
    清单 = 图书.在借清单(库)
    如果 不是 清单:
        输出（"  （当前没人借书）")
        返回
    对于 条 在 清单:
        逾期 = 条["逾期天数"]
        备注 = f"逾期 {逾期} 天，罚金 {条['罚金']} 元" if 逾期 大于 0 else "正常"
        输出（f"  《{条['书名']}》 借阅人 {条['借阅人']}  借出 {条['借出']}"
              f"  应还 {条['应还']}  {备注}")


定义 备份流程():
    件 = 数据.备份(库, 数据文件)
    输出（"已备份到：", 件)


定义 主():
    标记 菜单
    显示菜单()
    选择 = 输入("请选择：").去除空白()

    如果 选择 == "1":
        新增流程()
    否则如果 选择 == "2":
        打印清单(图书.搜索(库, ""))
    否则如果 选择 == "3":
        搜索流程()
    否则如果 选择 == "4":
        借书流程()
    否则如果 选择 == "5":
        还书流程()
    否则如果 选择 == "6":
        下架流程()
    否则如果 选择 == "7":
        汇总流程()
    否则如果 选择 == "8":
        借阅清单流程()
    否则如果 选择 == "9":
        备份流程()
    否则如果 选择 == "0" 或者 选择 == "退出":
        输出（"再见，欢迎再来借书")
        返回 0
    否则:
        输出（"没有这个选项：", 选择)

    跳转到 菜单


如果 __name__ == "__main__":
    运行环境.退出(主())
