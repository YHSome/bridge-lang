"""业务层：图书的增删改查、借书还书

只关心"数据怎么变"，不碰输入输出——这样主程序能随便换界面。
每本书一条记录：编号 / 书名 / 作者 / 总数 / 在借
每笔借阅一条记录：图书编号 / 书名 / 借阅人 / 借出 / 应还 / 逾期天数 / 罚金
"""

导入 日期

每人上限 = 3          # 一个人同时最多借 3 本
默认天数 = 14         # 借 14 天
每天罚金 = 0.5        # 逾期一天 0.5 元


定义 今天文本():
    返回 日期.现在().格式化日期("%Y-%m-%d")


定义 现在():
    返回 日期.现在().格式化日期("%Y-%m-%d %H:%M")


定义 取新编号(库):
    最大号 = 0
    对于 书 在 库["图书"]:
        如果 书["编号"] 大于 最大号:
            最大号 = 书["编号"]
    返回 最大号 + 1


定义 新增(库, 书名, 作者, 册数=1):
    """加一本新书；同名同作者视为同一本，把册数加上去"""
    书名 = 书名.去除空白()
    作者 = 作者.去除空白()
    如果 不是 书名:
        抛出 值错误("书名不能为空")
    如果 册数 小于 1:
        抛出 值错误("册数至少是 1")

    对于 书 在 库["图书"]:
        如果 书["书名"] == 书名 且 书["作者"] == 作者:
            书["总数"] += 册数
            返回 书, 假

    记录 = {
        "编号": 取新编号(库),
        "书名": 书名,
        "作者": 作者,
        "总数": 册数,
        "在借": 0,
    }
    库["图书"].追加(记录)
    返回 记录, 真


定义 按编号(库, 编号):
    对于 书 在 库["图书"]:
        如果 书["编号"] == 编号:
            返回 书
    返回 空


def 可借数(书):
    返回 书["总数"] - 书["在借"]


定义 搜索(库, 词):
    """按书名/作者/编号模糊搜，词为空就返回全部"""
    词 = 词.去除空白()
    结果 = []
    对于 书 在 库["图书"]:
        如果 不是 词:
            结果.追加(书)
            继续
        如果 (词 在 书["书名"]) 或者 (词 在 书["作者"]) 或者 (词 == 转字符串(书["编号"])):
            结果.追加(书)
    返回 结果


定义 下架(库, 编号):
    """删书；还有在外借阅的不许删"""
    书 = 按编号(库, 编号)
    如果 书 是 空:
        抛出 值错误(f"没有编号为 {编号} 的书")
    如果 书["在借"] 大于 0:
        抛出 值错误(f"《{书['书名']}》还有 {书['在借']} 本在外借，先还书再删")

    库["图书"] = [条 对于 条 在 库["图书"] 如果 条["编号"] != 编号]
    库["借阅"] = [条 对于 条 在 库["借阅"] 如果 条["图书编号"] != 编号]
    返回 书


定义 某人未还数(库, 借阅人):
    数 = 0
    对于 条 在 库["借阅"]:
        如果 条["借阅人"] == 借阅人:
            数 += 1
    返回 数


定义 逾期天数(条):
    """按"应还日期"算到今天差几天；没逾期返回 0"""
    如果 不是 条.get("应还"):
        返回 0
    应还 = 日期.解析(条["应还"], "%Y-%m-%d")
    差 = (日期.现在() - 应还).天数
    如果 差 小于 0:
        返回 0
    返回 差


定义 借书(库, 编号, 借阅人):
    """借一本；返回借阅记录（带应还日期）"""
    借阅人 = 借阅人.去除空白()
    如果 不是 借阅人:
        抛出 值错误("借阅人不能为空")
    书 = 按编号(库, 编号)
    如果 书 是 空:
        抛出 值错误(f"没有编号为 {编号} 的书")
    如果 可借数(书) 小于 1:
        抛出 值错误(f"《{书['书名']}》都借出去了，可借 0 本")
    未还 = 某人未还数(库, 借阅人)
    如果 未还 不小于 每人上限:
        抛出 值错误(f"{借阅人} 已经借了 {未还} 本（每人最多 {每人上限} 本），先还再借")

    应还日 = (日期.现在() + 时间差(默认天数)).格式化日期("%Y-%m-%d")
    记录 = {
        "图书编号": 书["编号"],
        "书名": 书["书名"],
        "借阅人": 借阅人,
        "借出": 现在(),
        "应还": 应还日,
        "逾期天数": 0,
        "罚金": 0,
    }
    书["在借"] += 1
    库["借阅"].追加(记录)
    返回 记录


定义 还书(库, 编号, 借阅人=""):
    """按编号（可再指定借阅人）还一本；返回还掉的借阅记录（含逾期与罚金）"""
    书 = 按编号(库, 编号)
    如果 书 是 空:
        抛出 值错误(f"没有编号为 {编号} 的书")

    目标 = 空
    对于 条 在 库["借阅"]:
        如果 条["图书编号"] != 编号:
            继续
        如果 借阅人 且 条["借阅人"] != 借阅人.去除空白():
            继续
        目标 = 条
        跳出
    如果 目标 是 空:
        如果 借阅人:
            抛出 值错误(f"「{借阅人}」名下没有借《{书['书名']}》")
        抛出 值错误(f"《{书['书名']}》没有借出记录（在借 {书['在借']} 本）")

    天数 = 逾期天数(目标)
    目标["逾期天数"] = 天数
    目标["罚金"] = 天数 * 每天罚金
    目标["归还"] = 现在()

    库["借阅"] = [条 对于 条 在 库["借阅"] 如果 条 is not 目标]
    书["在借"] -= 1
    如果 书["在借"] 小于 0:
        书["在借"] = 0
    返回 目标


定义 在借清单(库):
    结果 = []
    对于 条 在 库["借阅"]:
        天数 = 逾期天数(条)
        条["逾期天数"] = 天数
        条["罚金"] = 天数 * 每天罚金
        结果.追加(条)
    返回 结果


定义 汇总(库):
    总数 = 0
    在外 = 0
    罚金合计 = 0
    逾期册数 = 0
    对于 书 在 库["图书"]:
        总数 += 书["总数"]
        在外 += 书["在借"]
    对于 条 在 库["借阅"]:
        天数 = 逾期天数(条)
        如果 天数 大于 0:
            逾期册数 += 1
            罚金合计 += 天数 * 每天罚金
    返回 {
        "书目数": 求长度(库["图书"]),
        "总册数": 总数,
        "在借册数": 在外,
        "可借册数": 总数 - 在外,
        "借阅记录数": 求长度(库["借阅"]),
        "逾期册数": 逾期册数,
        "罚金合计": 罚金合计,
    }
