# 08 对象：类 + 方法 + JSON 对象
类 学生:
    定义 __init__(self, 名字, 分数):
        self.名字 = 名字
        self.分数 = 分数

    定义 等级(self):
        如果 self.分数 不小于 90:
            返回 "优秀"
        如果 self.分数 不小于 60:
            返回 "及格"
        返回 "不及格"

    定义 介绍(self):
        返回 f"{self.名字}：{self.分数} 分（{self.等级()}）"

张三 = 学生("张三", 92)
李四 = 学生("李四", 58)
输出（张三.介绍()）
输出（李四.介绍()）

# JSON 对象：按字段读写，保存回磁盘
新建文档（"./名单.json", {"班级": "三年二班", "学生": ["张三", "李四"]})
名单 = 读取（"./名单.json")
名单.学生.追加（"王五")
名单.保存()
输出（"班级：", 名单.班级, " 学生：", 名单.学生.原始())
名单.删除自己()          # 收尾：删掉示例文件
