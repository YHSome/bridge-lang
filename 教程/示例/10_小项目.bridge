# 10 小项目：把前面的东西拼成一个小清单（不用输入，直接跑）
导入 时间

书籍 = []

定义 添加(名字, 作者):
    书籍.追加（{"名字": 名字, "作者": 作者, "加的时间": 时间.格式化时间("%H:%M:%S")})
    返回 求长度(书籍)

定义 清单():
    如果 不是 书籍:
        输出（"  （空）")
        返回
    对于 序号, 书 在 枚举(书籍, 1):
        输出（f"  {序号}. 《{书['名字']}》  {书['作者']}  {书['加的时间']}")

定义 按作者找(作者):
    结果 = []
    对于 书 在 书籍:
        如果 书["作者"] == 作者:
            结果.追加（书["名字"])
    返回 结果

输出（"== 添加 ==")
添加("三体", "刘慈欣")
添加("活着", "余华")
添加("球状闪电", "刘慈欣")
清单()

输出（"== 按作者找 ==")
输出（"刘慈欣的书：", 按作者找("刘慈欣"))

输出（"== 菜单循环（标记/跳转到）==")
选择们 = ["1", "2", "0"]
序号 = 0
标记 菜单
选择 = 选择们[序号]
序号 += 1
如果 选择 == "1":
    输出（"  菜单1 → 又加了一本")
    添加("新书", "某人")
否则如果 选择 == "2":
    输出（"  菜单2 → 看清单")
    清单()
否则:
    输出（"  菜单0 → 退出")
    跳转到 结束
跳转到 菜单

标记 结束
输出（"共", 求长度(书籍), "本")
