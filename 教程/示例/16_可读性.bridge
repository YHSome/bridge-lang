# 第 16 章：可读性 —— 把 with / lambda / 切片冒号藏起来
#
#   python 桥.py 运行 教程/示例/16_可读性.bridge

类 学生:
    定义 初始化(自己, 名字, 分数):
        自己.名字 = 名字
        自己.分数 = 分数

    定义 报告(自己):
        返回 f"{自己.名字} {自己.分数} 分"

    定义 显示(自己):
        返回 自己.报告()

    定义 表示(自己):
        返回 自己.报告()

如果 是主程序:
    全班 = [学生("小明", 90), 学生("小红", 78), 学生("小刚", 95)]

    # 排序：不用 lambda，也不用记 key= / reverse=
    排名 = 排队(全班, 按="分数", 大的在前=真)
    对于 人 在 排名:
        输出（人）

    # 切片：不用冒号，从 1 数起、两头都算
    输出（"前两名：", 第几个到第几个(排名, 1, 2)）
    输出（"第一名：", 最后一个(排名)）

    # 列表操作：不用记 append / remove 的参数顺序
    名单 = ["甲", "乙"]
    交换 名单[0] 和 名单[1]
    把 "丙" 加到 名单 里
    如果 "丙" 在 名单 里:
        输出（"丙 加进去了：", 名单）
    把 "甲" 从 名单 里删掉
    输出（"删掉甲之后：", 名单）

    # 闭区间循环：从 1 到 3，两个数都算
    对于 序号 在 范围(0):          # 占位，避免空块
        通过
    从 1 到 3 每个 i:
        输出（"第", i, "圈")

    # 异常：不用 as，直接"记作"
    尝试执行:
        整数("这不是数字")
    捕获 值错误 记作 出错:
        输出（"抓到了：", 出错）
