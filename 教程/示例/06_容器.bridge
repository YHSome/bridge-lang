# 06 容器：列表 / 字典 / 字符串
书目 = []
书目.追加（"三体")
书目.追加（"活着")
书目.插入（1, "百年孤独")
输出（"书目：", 书目)
书目.排序()
输出（"排序后：", 书目）

借阅 = {"张三": ["三体"], "李四": []}
借阅["李四"].追加（"活着")
输出（"李四借了：", 借阅.取值("李四"))
输出（"有谁借过书：", 借阅.键列表())
输出（"张三借了吗：", "张三" 在 借阅)

句子 = "  你好，世界！  "
输出（"去空白：", 句子.去除空白())
输出（"替换：", 句子.去除空白().替换("世界", "爸爸"))
输出（"切开：", 句子.去除空白().拆分("，"))
