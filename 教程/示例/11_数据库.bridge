# 11 数据库：把数据存进 SQLite
库 = 读取("./学生.db")            # 不存在就新建
表 = 库.建表("学生", {
    "名字": "TEXT NOT NULL",
    "分数": "INTEGER",
})

表.插入({"名字": "张三", "分数": 90})
表.插入多([{"名字": "李四", "分数": 85}, {"名字": "王五", "分数": 77}])

输出（"共", 表.行数, "人")
输出（表.全部())
输出（表.查询("分数 >= ?", [85]))

# 事务：要么全成，要么全滚
尝试执行:
    带 库.事务():
        表.插入({"名字": "赵六", "分数": 60})
        抛出 值错误("故意炸")       # 这里炸了，赵六不会进库
捕获 值错误:
    输出（"已回滚，还是", 表.行数, "人")

# 改和删
表.更新({"分数": 95}, "名字 = ?", ["张三"])
表.删除行("分数 < ?", [60])
输出（"改删后：", 表.查询("名字 = ?", ["张三"]))

库.关闭()
库.删除自己()
