# 12 网络：取网页 / 发请求
# 直接跑会用 file:// 读本地文件（不联网）；换成 http 地址就是真请求。

导入 路径

本目录 = 路径.取目录(路径.绝对路径(__file__))
地址 = "file:///" + 路径.拼接(本目录, "..", "..", "示例", "特性", "配置.json").替换("\\", "/")

响应 = 取网页(地址)
输出（"状态码：", 响应.状态码, " 正常：", 响应.正常)
输出（"内容长度：", 求长度(响应.内容))

配置 = 响应.JSON
输出（"站点名：", 配置.站点名）

# 真联网时：
# 页面 = 取网页("https://example.com", 超时=10, 重试=2)
# 另存 = 页面.保存("./页面.html")
# 提交 = 发请求("https://example.com/api", {"名字": "爸爸"}, 方法="POST")
# 用 with 自动关闭：
# 带 取网页("https://example.com") 作为 页:
#     输出（页.状态码）
