# 05 函数：定义 / 返回 / 默认参数 / 递归
定义 打招呼(名字, 问候="你好"):
    返回 f"{问候}，{名字}！"

输出（打招呼("爸爸")）
输出（打招呼("爸爸", 问候="早上好")）


定义 阶乘(n):
    如果 n 不大于 1:
        返回 1
    返回 n * 阶乘(n - 1)

输出（"5 的阶乘：", 阶乘(5)）


定义 统计字数(句子):
    """返回值用"多返回值 + 元组"更自然"""
    字数 = 0
    对于 字 在 句子:
        如果 字 != " ":
            字数 += 1
    返回 字数, 求长度(句子)

字数, 总长 = 统计字数("你好 世界")
输出（"字数", 字数, "总长", 总长)
