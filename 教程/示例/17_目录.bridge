# 第 17 章：目录 —— 一个目录对象，点它拿文件
#
#   python 桥.py 运行 教程/示例/17_目录.bridge
#
# 不用 `os.listdir` 再自己拼路径，也不用记 `os.path.join`。

数据 = 打开目录(".")      # 相对路径按「这个脚本所在目录」找

输出（"=== 1. 目录里的文件（可以直接遍历）==="）
对于 件 在 数据:
    输出（"  ", 件.文件名, " ", 件.大小, " 字节")

输出（"=== 2. 只挑某类后缀 ==="）
对于 表 在 数据.按后缀("bridge"):
    输出（"  ", 表.文件名）

输出（"=== 3. 子目录 / 递归 ==="）
输出（"  子目录：", 数据.子目录们）
输出（"  递归找到：", 长度(数据.递归), " 个文件（已跳过 __pycache__ 之类）")

输出（"=== 4. 在目录里新建文件 ==="）
新 = 数据.新建文件("第17章测试.txt", "这一行是新建的")
输出（"  新建：", 新.文件名, " → ", 新.内容）
新.删除自己()

输出（"=== 5. 条目数 ==="）
输出（"  ", 数据.条目数, "（文件 + 子目录）")
