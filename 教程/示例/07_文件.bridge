# 07 文件：文本 / CSV 表格
# 文本：新建 → 读 → 追加 → 删掉
新建文档（"./笔记.txt", "第一行\n")
笔记 = 读取（"./笔记.txt")
笔记.追加（"第二行\n")
输出（"笔记内容：")
输出（笔记.内容）
输出（"文件大小：", 笔记.大小)
笔记.删除自己()

# CSV：读现成的 → 按列取值（只读，不改原文件）
表 = 读取（"./成绩.csv")
输出（"表头：", 表.表头)
输出（"分数列：", 表.列（"分数"))

# 新建一张表 → 追加 → 保存 → 删掉
新表 = 新建文档（"./临时成绩.csv", [["姓名", "分数"], ["张三", "90"]])
新表.追加行（["李四", "85"])
新表.保存()
输出（"新表行数：", 新表.行数)
新表.删除自己()
